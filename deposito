<body>

    <!-- Linha vermelha no topo -->
    <div class="top-bar"></div>

    <header class="header" id="mainHeader" style="display:none;">
        <div class="header-title">
            <h1 id="companyName" contenteditable="false">Controle de Estoque</h1>
            <span style="font-size:13px; opacity:0.7;">(clique no nome para editar)</span>
        </div>
        <div class="header-user">
            <span id="userDisplay"></span>
            <button class="btn-logout" onclick="logout()">Sair</button>
        </div>
    </header>

    <div class="container">

        <div id="authContainer" class="auth-container">
            <h2>Bem-vindo</h2>
            <p class="subtitle">Gerencie seu estoque de pneus e frota de veículos</p>

            <div class="auth-tabs">
                <button class="active" data-tab="login" onclick="switchAuthTab('login')">Login</button>
                <button data-tab="register" onclick="switchAuthTab('register')">Criar Conta</button>
            </div>

            <form id="loginForm" class="auth-form active" onsubmit="login(event)">
                <div class="auth-error" id="loginError">Credenciais inválidas</div>
                <label>E-mail</label>
                <input type="email" id="loginEmail" placeholder="seu@email.com" required>
                <label>Senha</label>
                <input type="password" id="loginPassword" placeholder="••••••••" required>
                <button type="submit" class="btn-primary">Entrar</button>
            </form>

            <form id="registerForm" class="auth-form" onsubmit="register(event)">
                <div class="auth-error" id="registerError">Erro ao cadastrar</div>
                <label>Nome completo</label>
                <input type="text" id="regName" placeholder="Seu nome" required>
                <label>Nome da Empresa</label>
                <input type="text" id="regCompany" placeholder="Nome da sua empresa" required>
                <label>E-mail</label>
                <input type="email" id="regEmail" placeholder="seu@email.com" required>
                <label>Senha</label>
                <input type="password" id="regPassword" placeholder="Mínimo 6 caracteres" minlength="6" required>
                <button type="submit" class="btn-primary">Criar Conta</button>
            </form>
        </div>

        <div id="appContainer" class="app-container">

            <div class="tabs">
                <button class="active" data-tab="tab-cadastro" onclick="switchTab('tab-cadastro')">📦 Cadastrar Pneu</button>
                <button data-tab="tab-estoque" onclick="switchTab('tab-estoque')">📋 Estoque</button>
                <button data-tab="tab-veiculos" onclick="switchTab('tab-veiculos')">🚗 Veículos</button>
                <button data-tab="tab-descartados" onclick="switchTab('tab-descartados')">🗑️ Descartados</button>
            </div>

            <div class="tab-content">

                <div id="tab-cadastro" class="tab-pane active">
                    <h3 style="color:#1a3a5c; margin-bottom:20px;">Cadastrar Novo Pneu</h3>
                    <form id="pneuForm" onsubmit="cadastrarPneu(event)">
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Nome do Pneu</label>
                                <div class="input-group">
                                    <select id="pneuNomeSelect" onchange="handlePneuSelect()">
                                        <option value="">Selecione...</option>
                                        <option value="Michelin">Michelin</option>
                                        <option value="Pirelli">Pirelli</option>
                                        <option value="Goodyear">Goodyear</option>
                                        <option value="Bridgestone">Bridgestone</option>
                                        <option value="Continental">Continental</option>
                                        <option value="outros">Outros...</option>
                                    </select>
                                    <input type="text" id="pneuNomeOutros" placeholder="Digite o nome" class="hidden" style="flex:1;">
                                </div>
                            </div>
                            <div class="form-group">
                                <label>DOT / Fogo (opcional)</label>
                                <input type="text" id="pneuDot" placeholder="Ex: DOT 1234">
                            </div>
                            <div class="form-group">
                                <label>Tamanho</label>
                                <div class="input-group">
                                    <select id="pneuTamanhoSelect" onchange="handleTamanhoSelect()">
                                        <option value="">Selecione...</option>
                                        <option value="215">215</option>
                                        <option value="235">235</option>
                                        <option value="275">275</option>
                                        <option value="295">295</option>
                                        <option value="outros">Outros...</option>
                                    </select>
                                    <input type="text" id="pneuTamanhoOutros" placeholder="Digite o tamanho" class="hidden" style="flex:1;">
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Tipo do Pneu</label>
                                <select id="pneuTipo">
                                    <option value="liso">Liso</option>
                                    <option value="misto">Misto</option>
                                    <option value="borrachudo">Borrachudo</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Situação</label>
                                <select id="pneuSituacao">
                                    <option value="novo">Novo</option>
                                    <option value="meia vida">Meia Vida</option>
                                    <option value="recapado">Recapado</option>
                                    <option value="carcaça">Carcaça</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Valor Pago (R$)</label>
                                <input type="number" id="pneuValor" value="0" min="0" step="0.01">
                            </div>
                            <div class="form-group">
                                <label>Quantidade</label>
                                <input type="number" id="pneuQuantidade" value="1" min="1" step="1">
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn-success">Cadastrar Pneu</button>
                                <button type="reset" class="btn-secondary">Limpar</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div id="tab-estoque" class="tab-pane">
                    <div class="estoque-header">
                        <h2>Estoque de Pneus</h2>
                        <div class="estoque-stats">
                            <span id="totalPneus">Total: 0</span>
                            <span id="totalItens">Itens: 0</span>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Nome</th>
                                    <th>DOT/Fogo</th>
                                    <th>Tamanho</th>
                                    <th>Tipo</th>
                                    <th>Situação</th>
                                    <th>Status</th>
                                    <th>Valor (R$)</th>
                                    <th>Qtd</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="estoqueTableBody">
                                <tr><td colspan="10" class="empty-state"><p>Nenhum pneu cadastrado ainda.</p></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="tab-veiculos" class="tab-pane">
                    <h3 style="color:#1a3a5c; margin-bottom:20px;">Cadastrar Veículo</h3>
                    <form id="veiculoForm" onsubmit="cadastrarVeiculo(event)">
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Marca</label>
                                <input type="text" id="veiculoMarca" placeholder="Ex: Ford" required>
                            </div>
                            <div class="form-group">
                                <label>Modelo</label>
                                <input type="text" id="veiculoModelo" placeholder="Ex: F-4000" required>
                            </div>
                            <div class="form-group">
                                <label>Placa</label>
                                <input type="text" id="veiculoPlaca" placeholder="Ex: ABC-1234" required>
                            </div>
                            <div class="form-group">
                                <label>Motorista</label>
                                <input type="text" id="veiculoMotorista" placeholder="Nome do motorista" required>
                            </div>
                            <div class="form-group">
                                <label>Quilometragem Atual (KM)</label>
                                <input type="number" id="veiculoKm" placeholder="0" min="0" value="0" required>
                            </div>
                            <div class="form-group">
                                <label>Tipo de Veículo (Eixos)</label>
                                <select id="veiculoEixos" required>
                                    <option value="3">3 Eixos</option>
                                    <option value="4">4 Eixos</option>
                                    <option value="5" selected>5 Eixos</option>
                                    <option value="6">6 Eixos</option>
                                    <option value="7">7 Eixos</option>
                                    <option value="9">9 Eixos</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Status</label>
                                <select id="veiculoStatus">
                                    <option value="ativo">Ativo</option>
                                    <option value="inativo">Inativo</option>
                                </select>
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn-success">Cadastrar Veículo</button>
                                <button type="reset" class="btn-secondary">Limpar</button>
                            </div>
                        </div>
                    </form>

                    <hr style="margin: 30px 0; border-color: #e8ecf0;">

                    <div class="veiculos-header">
                        <h2>Veículos Cadastrados</h2>
                        <div class="veiculos-stats">
                            <span id="totalVeiculos">Total: 0</span>
                            <span id="veiculosAtivos">Ativos: 0</span>
                        </div>
                    </div>

                    <div id="veiculosGrid" class="veiculos-grid"></div>
                </div>

                <div id="tab-descartados" class="tab-pane">
                    <div class="estoque-header">
                        <h2>Pneus Descartados</h2>
                        <div class="estoque-stats">
                            <span id="totalDescartados">Total: 0</span>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Nome</th>
                                    <th>DOT/Fogo</th>
                                    <th>Tamanho</th>
                                    <th>Tipo</th>
                                    <th>Motivo</th>
                                    <th>Data Descarte</th>
                                    <th>Valor (R$)</th>
                                </tr>
                            </thead>
                            <tbody id="descartadosTableBody">
                                <tr><td colspan="8" class="empty-state"><p>Nenhum pneu descartado ainda.</p></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Modal do Caminhão -->
    <div id="modalCaminhao" class="modal-overlay">
        <div class="modal-content">
            <button class="modal-close" onclick="fecharModalCaminhao()">✕</button>
            <h2 class="modal-title" id="modalVeiculoTitle">Veículo</h2>
            <div id="caminhaoContainer" class="caminhao-container"></div>
            <div style="margin-top:20px; text-align:center; color:#666; font-size:13px;">
                💡 Clique em um pneu vazio para instalar ou arraste um pneu para outra posição
            </div>
        </div>
    </div>

    <!-- Modal de Seleção de Pneus -->
    <div id="modalSelecao" class="modal-selecao">
        <div class="modal-selecao-content">
            <h3>Selecionar Pneu</h3>
            <div id="infoPneuSelecao" style="margin-bottom:15px; color:#666; font-size:14px;"></div>
            <div id="listaPneusDisponiveis" class="lista-pneus-disponiveis"></div>
            <button class="modal-selecao-close" onclick="fecharModalSelecao()">Cancelar</button>
        </div>
    </div>

    <!-- Modal de Instalação (KM) -->
    <div id="modalInstalacao" class="modal-instalacao">
        <div class="modal-instalacao-content">
            <h3>Instalar Pneu</h3>
            <p class="subtitle">Informe a quilometragem atual do veículo</p>
            <div id="infoInstalacao" style="margin-bottom:15px; color:#666; font-size:14px;"></div>
            <div class="form-group">
                <label>Quilometragem Atual do Veículo (KM)</label>
                <input type="number" id="kmInstalacao" placeholder="Digite a KM atual" min="0" required>
            </div>
            <div class="modal-instalacao-actions">
                <button class="btn-confirmar" onclick="confirmarInstalacao()">Confirmar Instalação</button>
                <button class="btn-cancelar" onclick="fecharModalInstalacao()">Cancelar</button>
            </div>
        </div>
    </div>

    <!-- Modal de Remoção -->
    <div id="modalRemocao" class="modal-remocao">
        <div class="modal-remocao-content">
            <h3>Remover Pneu</h3>
            <p class="subtitle">Informe os detalhes da remoção deste pneu</p>
            
            <div id="pneuRemocaoInfo" class="pneu-info-box"></div>
            
            <div class="form-group">
                <label>Quilometragem Atual (KM)</label>
                <input type="number" id="kmRemocao" placeholder="Digite a KM atual" min="0" required>
            </div>
            
            <div class="form-group">
                <label>Destino do Pneu</label>
                <select id="destinoPneu" required>
                    <option value="">Selecione...</option>
                    <option value="estoque_meia_vida">Voltar para Estoque como Meia Vida</option>
                    <option value="recapagem">Enviar para Recapagem</option>
                    <option value="vulcanizacao">Enviar para Vulcanização</option>
                    <option value="descarte">Descarte</option>
                </select>
            </div>
            
            <div class="modal-remocao-actions">
                <button class="btn-confirmar" onclick="confirmarRemocao()">Confirmar Remoção</button>
                <button class="btn-cancelar" onclick="fecharModalRemocao()">Cancelar</button>
            </div>

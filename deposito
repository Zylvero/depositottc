                                <span class="badge ${statusBadge}">${v.status}</span>
                            </div>
                            <div class="veiculo-card-info">
                                <span><span class="label">Placa:</span> ${v.placa}</span>
                                <span><span class="label">Motorista:</span> ${v.motorista}</span>
                                <span><span class="label">KM:</span> ${v.km.toLocaleString('pt-BR')}</span>
                                <span><span class="label">Eixos:</span> ${v.eixos}</span>
                                <span style="grid-column:1/-1;"><span class="label">Pneus:</span> ${pneusInstalados} / ${totalPneus}</span>
                            </div>
                            <div class="veiculo-card-actions">
                                <button class="btn-danger" onclick="event.stopPropagation(); excluirVeiculo(${v.id})">🗑️</button>
                                <button class="btn-info" onclick="event.stopPropagation(); toggleStatusVeiculo(${v.id})">${v.status === 'ativo' ? '🔄' : '✅'}</button>

                <label>Tipo de Serviço</label>
                <select id="tipoServico" required>
                    <option value="">Selecione...</option>
                    <option value="rodizio">Rodízio</option>
                    <option value="remendo">Remendo</option>
                </select>
            </div>
            
            <div class="form-group">
                <label>Valor do Serviço (R$)</label>
                <input type="number" id="valorServico" placeholder="0,00" min="0" step="0.01" required>
            </div>
            
            <div class="modal-servico-actions">
                <button class="btn-confirmar" onclick="confirmarServico()">Adicionar Serviço</button>
                <button class="btn-cancelar" onclick="fecharModalServico()">Cancelar</button>
            </div>
        </div>
    </div>

    <script>
        // ============================================
        //  BANCO DE DADOS
        // ============================================
        function getUsers() {
            return JSON.parse(localStorage.getItem('estoque_users')) || [];
        }

        function setUsers(users) {
            localStorage.setItem('estoque_users', JSON.stringify(users));
        }

        function getPneus() {
            return JSON.parse(localStorage.getItem('estoque_pneus')) || [];
        }

        function setPneus(pneus) {
            localStorage.setItem('estoque_pneus', JSON.stringify(pneus));
        }

        function getVeiculos() {
            return JSON.parse(localStorage.getItem('estoque_veiculos')) || [];
        }

        function setVeiculos(veiculos) {
            localStorage.setItem('estoque_veiculos', JSON.stringify(veiculos));
        }

        function getDescartados() {
            return JSON.parse(localStorage.getItem('estoque_descartados')) || [];
        }

        function setDescartados(descartados) {
            localStorage.setItem('estoque_descartados', JSON.stringify(descartados));
        }

        function getCurrentUser() {
            return JSON.parse(localStorage.getItem('estoque_current_user'));
        }

        function setCurrentUser(user) {
            localStorage.setItem('estoque_current_user', JSON.stringify(user));
        }

        function clearCurrentUser() {
            localStorage.removeItem('estoque_current_user');
        }

        // ============================================
        //  AUTH
        // ============================================
        function switchAuthTab(tab) {
            document.querySelectorAll('.auth-tabs button').forEach(b => b.classList.remove('active'));
            document.querySelector(`.auth-tabs button[data-tab="${tab}"]`).classList.add('active');
            document.querySelectorAll('.auth-form').forEach(f => f.classList.remove('active'));
            if (tab === 'login') {
                document.getElementById('loginForm').classList.add('active');
            } else {
                document.getElementById('registerForm').classList.add('active');
            }
            document.getElementById('loginError').classList.remove('show');
            document.getElementById('registerError').classList.remove('show');
        }

        function register(e) {
            e.preventDefault();
            const name = document.getElementById('regName').value.trim();
            const company = document.getElementById('regCompany').value.trim();
            const email = document.getElementById('regEmail').value.trim();
            const password = document.getElementById('regPassword').value;

            const users = getUsers();
            if (users.find(u => u.email === email)) {
                const err = document.getElementById('registerError');
                err.textContent = 'Este e-mail já está cadastrado.';
                err.classList.add('show');
                return;
            }

            const newUser = {
                id: Date.now(),
                name,
                company,
                email,
                password,
                companyName: company
            };
            users.push(newUser);
            setUsers(users);

            setCurrentUser(newUser);
            document.getElementById('registerError').classList.remove('show');
            enterApp();
        }

        function login(e) {
            e.preventDefault();
            const email = document.getElementById('loginEmail').value.trim();
            const password = document.getElementById('loginPassword').value;

            const users = getUsers();
            const user = users.find(u => u.email === email && u.password === password);

            if (!user) {
                const err = document.getElementById('loginError');
                err.textContent = 'E-mail ou senha incorretos.';
                err.classList.add('show');
                return;
            }

            setCurrentUser(user);
            document.getElementById('loginError').classList.remove('show');
            enterApp();
        }

        function logout() {
            clearCurrentUser();
            document.getElementById('appContainer').classList.remove('show');
            document.getElementById('mainHeader').style.display = 'none';
            document.getElementById('authContainer').style.display = 'block';
            document.getElementById('loginForm').reset();
            document.getElementById('registerForm').reset();
            switchAuthTab('login');
        }

        function enterApp() {
            const user = getCurrentUser();
            if (!user) return;

            document.getElementById('authContainer').style.display = 'none';
            document.getElementById('mainHeader').style.display = 'flex';
            document.getElementById('appContainer').classList.add('show');

            const companyEl = document.getElementById('companyName');
            companyEl.textContent = `Controle de Estoque (${user.companyName || user.company || 'Minha Empresa'})`;
            companyEl.dataset.baseName = user.companyName || user.company || 'Minha Empresa';

            document.getElementById('userDisplay').textContent = `👤 ${user.name}`;

            renderEstoque();
            renderVeiculos();
            renderDescartados();
            switchTab('tab-cadastro');
        }

        document.getElementById('companyName').addEventListener('focus', function() {
            this.contentEditable = true;
            this.style.borderColor = '#ffd700';
        });

        document.getElementById('companyName').addEventListener('blur', function() {
            this.contentEditable = false;
            this.style.borderColor = 'transparent';
            let newName = this.textContent.trim();
            const prefix = 'Controle de Estoque (';
            if (newName.startsWith(prefix) && newName.endsWith(')')) {
                newName = newName.substring(prefix.length, newName.length - 1);
            }
            if (newName.length > 0) {
                const user = getCurrentUser();
                if (user) {
                    const users = getUsers();
                    const idx = users.findIndex(u => u.id === user.id);
                    if (idx !== -1) {
                        users[idx].companyName = newName;
                        users[idx].company = newName;
                        setUsers(users);
                        user.companyName = newName;
                        user.company = newName;
                        setCurrentUser(user);
                    }
                }
                this.textContent = `Controle de Estoque (${newName})`;
                this.dataset.baseName = newName;
            } else {
                this.textContent = `Controle de Estoque (${this.dataset.baseName || 'Minha Empresa'})`;
            }
        });

        function switchTab(tabId) {
            document.querySelectorAll('.tabs button').forEach(b => b.classList.remove('active'));
            document.querySelector(`.tabs button[data-tab="${tabId}"]`).classList.add('active');
            document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');

            if (tabId === 'tab-estoque') {
                renderEstoque();
            }
            if (tabId === 'tab-veiculos') {
                renderVeiculos();
            }
            if (tabId === 'tab-descartados') {
                renderDescartados();
            }
        }

        // ============================================
        //  FORMULÁRIO PNEU
        // ============================================
        function handlePneuSelect() {
            const select = document.getElementById('pneuNomeSelect');
            const outros = document.getElementById('pneuNomeOutros');
            if (select.value === 'outros') {
                outros.classList.remove('hidden');
                outros.required = true;
                outros.focus();
            } else {
                outros.classList.add('hidden');
                outros.required = false;

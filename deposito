        function fecharModalServico() {
            document.getElementById('modalServico').classList.remove('show');
            slotServico = null;
        }

        function confirmarServico() {
            const tipo = document.getElementById('tipoServico').value;
            const valor = parseFloat(document.getElementById('valorServico').value);

            if (!tipo) {
                alert('Por favor, selecione o tipo de serviço.');
                return;
            }

            if (!valor || valor <= 0) {
                alert('Por favor, informe um valor válido.');
                return;
            }

            const pneuId = veiculoAtual.pneus[slotServico];
            if (!pneuId) {
                alert('Erro: Pneu não encontrado.');
                fecharModalServico();
                return;
            }

            const pneus = getPneus();
            const pneu = pneus.find(p => p.id === pneuId);
            if (!pneu) {
                alert('Erro: Pneu não encontrado no estoque.');
                fecharModalServico();
                return;
            }

            // Adiciona o valor ao pneu
            pneu.valor += valor;

            // Registra no histórico
            const servicoLabel = tipo === 'rodizio' ? 'Rodízio' : 'Remendo';
            pneu.historico = pneu.historico || [];
            pneu.historico.push({
                data: new Date().toLocaleString('pt-BR'),
                acao: servicoLabel,
                detalhes: `${servicoLabel} realizado no valor de R$ ${valor.toFixed(2)} no veículo ${veiculoAtual.placa}`
            });

            // Atualiza o valor específico
            if (tipo === 'rodizio') {
                pneu.valorRodizio = (pneu.valorRodizio || 0) + valor;
            } else if (tipo === 'remendo') {
                pneu.valorRemendo = (pneu.valorRemendo || 0) + valor;
            }

            setPneus(pneus);

            fecharModalServico();
            renderCaminhao(veiculoAtual);
            renderVeiculos();
            renderEstoque();
            alert(`✅ ${servicoLabel} adicionado com sucesso! Novo valor do pneu: R$ ${pneu.valor.toFixed(2)}`);
        }


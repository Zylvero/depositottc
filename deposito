    <!-- Modal de Edição -->
    <div id="modalEdicao" class="modal-edicao">
        <div class="modal-edicao-content">
            <h3>Editar Pneu</h3>
            <p class="subtitle">Gerencie as informações deste pneu</p>
            
            <div id="pneuEdicaoInfo" class="pneu-info-box"></div>
            
            <div class="form-group">
                <label>Valor de Recapagem (R$)</label>
                <input type="number" id="valorRecapagem" placeholder="0,00" min="0" step="0.01">
            </div>
            
            <div class="form-group">
                <label>Valor de Vulcanização (R$)</label>
                <input type="number" id="valorVulcanizacao" placeholder="0,00" min="0" step="0.01">
            </div>
            
            <div class="form-group">
                <label>Ações</label>
                <select id="acaoEdicao">
                    <option value="">Selecione uma ação...</option>
                    <option value="recapagem">Marcar como Recapado</option>
                    <option value="vulcanizacao">Marcar como Vulcanizado</option>
                    <option value="descarte">Enviar para Descarte</option>
                </select>

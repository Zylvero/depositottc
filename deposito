        .modal-servico-content input:focus,
        .modal-servico-content select:focus {
            outline: none;
            border-color: #2a5f7a;
        }

        .modal-servico-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .modal-servico-actions button {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        @media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
            .header {
                padding: 15px 20px;

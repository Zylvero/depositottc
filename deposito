            }
        }

        function handleTamanhoSelect() {
            const select = document.getElementById('pneuTamanhoSelect');
            const outros = document.getElementById('pneuTamanhoOutros');
            if (select.value === 'outros') {
                outros.classList.remove('hidden');
                outros.required = true;
                outros.focus();
            } else {
                outros.classList.add('hidden');
                outros.required = false;
                outros.value = '';
            }
        }

        // ============================================
        //  CADASTRAR PNEU
        // ============================================
        function cadastrarPneu(e) {
            e.preventDefault();

            let nome = document.getElementById('pneuNomeSelect').value;
            if (nome === 'outros') {
                nome = document.getElementById('pneuNomeOutros').value.trim();
            }
            if (!nome) {
                alert('Por favor, selecione ou digite o nome do pneu.');
                return;
            }

            let tamanho = document.getElementById('pneuTamanhoSelect').value;
            if (tamanho === 'outros') {
                tamanho = document.getElementById('pneuTamanhoOutros').value.trim();
            }
            if (!tamanho) {
                alert('Por favor, selecione ou digite o tamanho do pneu.');
                return;
            }

            const dot = document.getElementById('pneuDot').value.trim();
            const tipo = document.getElementById('pneuTipo').value;
            const situacao = document.getElementById('pneuSituacao').value;
            const valor = parseFloat(document.getElementById('pneuValor').value) || 0;
            const quantidade = parseInt(document.getElementById('pneuQuantidade').value) || 1;

            const pneus = getPneus();
            for (let i = 0; i < quantidade; i++) {
                const pneu = {
                    id: Date.now() + i + Math.random() * 1000,
                    nome,
                    dot,
                    tamanho,
                    tipo,
                    situacao,
                    valor,
                    valorRecapagem: 0,
                    valorVulcanizacao: 0,
                    valorRodizio: 0,
                    valorRemendo: 0,
                    quantidade: 1,
                    status: 'disponivel',
                    veiculoInstalado: null,
                    dataCadastro: new Date().toLocaleDateString('pt-BR'),
                    historico: [{
                        data: new Date().toLocaleString('pt-BR'),
                        acao: 'Cadastro',
                        detalhes: `Pneu cadastrado como ${situacao}`
                    }]
                };
                pneus.push(pneu);
            }

            setPneus(pneus);

            document.getElementById('pneuDot').value = '';
            document.getElementById('pneuValor').value = '0';
            document.getElementById('pneuQuantidade').value = '1';
            document.getElementById('pneuNomeSelect').value = '';
            document.getElementById('pneuTamanhoSelect').value = '';
            document.getElementById('pneuTipo').value = 'liso';
            document.getElementById('pneuSituacao').value = 'novo';
            document.getElementById('pneuNomeOutros').classList.add('hidden');
            document.getElementById('pneuNomeOutros').value = '';
            document.getElementById('pneuTamanhoOutros').classList.add('hidden');
            document.getElementById('pneuTamanhoOutros').value = '';

            renderEstoque();
            switchTab('tab-estoque');
            alert(`✅ ${quantidade} pneu(s) cadastrado(s) com sucesso!`);
        }

        // ============================================
        //  RENDER ESTOQUE
        // ============================================
        function renderEstoque() {
            const pneus = getPneus();
            const tbody = document.getElementById('estoqueTableBody');

            if (pneus.length === 0) {
                tbody.innerHTML = `<tr><td colspan="10" class="empty-state"><p>Nenhum pneu cadastrado ainda.</p></td></tr>`;
                document.getElementById('totalPneus').textContent = 'Total: 0';
                document.getElementById('totalItens').textContent = 'Itens: 0';
                return;
            }

            const grupos = {};
            pneus.forEach(p => {
                const key = `${p.nome}-${p.tamanho}-${p.tipo}-${p.situacao}-${p.status}`;
                if (!grupos[key]) {
                    grupos[key] = {
                        ...p,
                        quantidade: 0,
                        ids: []
                    };
                }
                grupos[key].quantidade += 1;
                grupos[key].ids.push(p.id);
            });

            let totalQtd = pneus.length;
            let html = '';
            let index = 0;
            Object.values(grupos).forEach(g => {
                index++;
                const badgeSituacao = {
                    'novo': 'badge-novo',
                    'meia vida': 'badge-meia',
                    'recapado': 'badge-recap',
                    'carcaça': 'badge-carcaça',
                    'vulcanizado': 'badge-vulcanizado'
                } [g.situacao] || '';

                const badgeTipo = {
                    'liso': 'badge-liso',
                    'misto': 'badge-misto',
                    'borrachudo': 'badge-borrachudo'
                } [g.tipo] || '';

                const badgeStatus = {
                    'disponivel': 'badge-novo',
                    'instalado': 'badge-instalado',
                    'recapagem': 'badge-recap',
                    'vulcanizacao': 'badge-vulcanizado'
                } [g.status] || '';

                let statusLabel = g.status || 'disponivel';
                if (statusLabel === 'instalado' && g.veiculoInstalado) {
                    statusLabel = `Instalado (${g.veiculoInstalado})`;
                } else if (statusLabel === 'instalado') {
                    statusLabel = 'Instalado';
                } else if (statusLabel === 'recapagem') {
                    statusLabel = 'Em Recapagem';
                } else if (statusLabel === 'vulcanizacao') {
                    statusLabel = 'Em Vulcanização';
                } else {
                    statusLabel = 'Disponível';
                }

                const emUso = g.ids.some(id => {
                    const veiculos = getVeiculos();
                    let usado = false;
                    veiculos.forEach(v => {
                        if (v.pneus) {
                            Object.values(v.pneus).forEach(pneuId => {
                                if (pneuId === id) usado = true;
                            });
                        }
                    });
                    return usado;
                });

                html += `
                        <tr>
                            <td>${index}</td>
                            <td><strong>${g.nome}</strong></td>
                            <td>${g.dot || '-'}</td>
                            <td>${g.tamanho}</td>
                            <td><span class="badge ${badgeTipo}">${g.tipo}</span></td>
                            <td><span class="badge ${badgeSituacao}">${g.situacao}</span></td>
                            <td><span class="badge ${badgeStatus}">${statusLabel}</span></td>
                            <td>R$ ${g.valor.toFixed(2)}</td>
                            <td>${g.quantidade}</td>
                            <td>
                                <button class="btn-info" onclick="abrirModalEdicao('${g.ids.join(',')}')" title="Editar Pneu">✏️</button>
                                <button class="btn-danger" onclick="excluirPneuGrupo('${g.ids.join(',')}')" ${emUso ? 'disabled style="opacity:0.5;"' : ''} title="${emUso ? 'Pneu em uso' : 'Excluir'}">
                                    ${emUso ? '🔒' : '🗑️'}
                                </button>
                            </td>
                        </tr>
                    `;
            });

            tbody.innerHTML = html;
            document.getElementById('totalPneus').textContent = `Total: ${Object.keys(grupos).length}`;
            document.getElementById('totalItens').textContent = `Itens: ${totalQtd}`;
        }

        function excluirPneuGrupo(idsString) {
            const ids = idsString.split(',').map(Number);
            if (!confirm(`Tem certeza que deseja excluir ${ids.length} pneu(s)?`)) return;

            let pneus = getPneus();
            pneus = pneus.filter(p => !ids.includes(p.id));
            setPneus(pneus);
            renderEstoque();
        }


        function excluirVeiculo(id) {
            if (!confirm('Tem certeza que deseja excluir este veículo? Isso devolverá todos os pneus ao estoque.')) return;

            const veiculos = getVeiculos();
            const veiculo = veiculos.find(v => v.id === id);

            if (veiculo && veiculo.pneus) {
                const pneus = getPneus();
                Object.values(veiculo.pneus).forEach(pneuId => {
                    const pneu = pneus.find(p => p.id === pneuId);
                    if (pneu) {
                        pneu.status = 'disponivel';
                        pneu.veiculoInstalado = null;
                        pneu.historico = pneu.historico || [];
                        pneu.historico.push({
                            data: new Date().toLocaleString('pt-BR'),
                            acao: 'Remoção (Exclusão Veículo)',
                            detalhes: `Pneu removido do veículo ${veiculo.placa} - ${veiculo.marca} ${veiculo.modelo}`
                        });
                    }
                });
                setPneus(pneus);
            }

            const novosVeiculos = veiculos.filter(v => v.id !== id);
            setVeiculos(novosVeiculos);
            renderVeiculos();
            renderEstoque();
        }

        function toggleStatusVeiculo(id) {
            let veiculos = getVeiculos();
            const idx = veiculos.findIndex(v => v.id === id);
            if (idx !== -1) {
                veiculos[idx].status = veiculos[idx].status === 'ativo' ? 'inativo' : 'ativo';
                setVeiculos(veiculos);
                renderVeiculos();
            }
        }

        // ============================================
        //  FUNÇÕES DE DRAG AND DROP
        // ============================================
        let dragData = null;

        function iniciarDrag(e, veiculoId, slotId) {
            const veiculos = getVeiculos();
            const veiculo = veiculos.find(v => v.id === veiculoId);
            if (!veiculo || !veiculo.pneus) return;
            
            const pneuId = veiculo.pneus[slotId];
            if (!pneuId) return;

            dragData = {
                veiculoId: veiculoId,
                slotOrigem: slotId,
                pneuId: pneuId
            };

            e.target.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', slotId);
        }

        function permitirDrop(e) {
            e.preventDefault();
            e.target.closest('.pneu-slot')?.classList.add('drag-over');
        }

        function limparDrag(e) {
            document.querySelectorAll('.pneu-slot').forEach(el => {
                el.classList.remove('dragging', 'drag-over');
            });
        }

        function finalizarDrop(e, veiculoId, slotDestino) {
            e.preventDefault();
            limparDrag(e);

            if (!dragData) return;
            if (dragData.veiculoId !== veiculoId) {
                alert('Não é possível mover pneus entre veículos diferentes.');
                dragData = null;
                return;
            }
            if (dragData.slotOrigem === slotDestino) {
                dragData = null;
                return;
            }

            const veiculos = getVeiculos();
            const veiculo = veiculos.find(v => v.id === veiculoId);
            if (!veiculo || !veiculo.pneus) {
                dragData = null;
                return;
            }

            const pneuDestinoId = veiculo.pneus[slotDestino];
            const pneuOrigemId = veiculo.pneus[dragData.slotOrigem];
            if (!pneuOrigemId) {
                dragData = null;
                return;
            }

            delete veiculo.pneus[dragData.slotOrigem];
            if (pneuDestinoId) {
                veiculo.pneus[dragData.slotOrigem] = pneuDestinoId;
            }
            veiculo.pneus[slotDestino] = pneuOrigemId;

            const idx = veiculos.findIndex(v => v.id === veiculoId);
            if (idx !== -1) {
                veiculos[idx] = veiculo;
                setVeiculos(veiculos);
            }

            const pneus = getPneus();
            const pneu = pneus.find(p => p.id === pneuOrigemId);
            if (pneu) {
                pneu.historico = pneu.historico || [];
                pneu.historico.push({
                    data: new Date().toLocaleString('pt-BR'),
                    acao: 'Movimentação',
                    detalhes: `Pneu movido de ${dragData.slotOrigem} para ${slotDestino} no veículo ${veiculo.placa}`
                });
                setPneus(pneus);
            }

            dragData = null;
            renderCaminhao(veiculo);
            renderVeiculos();
            renderEstoque();
        }

        // ============================================
        //  VARIÁVEIS GLOBAIS PARA INSTALAÇÃO
        // ============================================
        let veiculoAtual = null;
        let slotSelecionado = null;
        let pneuSelecionadoId = null;
        let veiculoInstalacaoId = null;

        // ============================================
        //  MODAL DO CAMINHÃO
        // ============================================
        function abrirModalCaminhao(id) {
            const veiculos = getVeiculos();
            const veiculo = veiculos.find(v => v.id === id);
            if (!veiculo) return;

            veiculoAtual = veiculo;
            document.getElementById('modalVeiculoTitle').textContent = `${veiculo.marca} ${veiculo.modelo} - ${veiculo.placa}`;
            document.getElementById('modalCaminhao').classList.add('show');
            renderCaminhao(veiculo);
        }

        function fecharModalCaminhao() {
            document.getElementById('modalCaminhao').classList.remove('show');
            veiculoAtual = null;
            slotSelecionado = null;
            pneuSelecionadoId = null;
            veiculoInstalacaoId = null;
            dragData = null;
        }

        function renderCaminhao(veiculo) {
            const container = document.getElementById('caminhaoContainer');
            const eixos = veiculo.eixos;
            const pneus = veiculo.pneus || {};

            let html = `<div class="caminhao">`;

            html += `
                    <div class="eixos-row">
                        <div class="eixo eixo-dianteiro">
                            <div class="eixo-label">🚛 Dianteiro</div>
                            <div class="eixo-pneus">
                                ${renderPneuSlot(veiculo, 'dianteiro-esquerdo', pneus['dianteiro-esquerdo'])}
                                ${renderPneuSlot(veiculo, 'dianteiro-direito', pneus['dianteiro-direito'])}
                            </div>
                        </div>
                    </div>
                `;

            for (let i = 1; i < eixos; i++) {
                const label = i === 1 ? '1º Eixo Traseiro' : `${i}º Eixo Traseiro`;
                html += `
                        <div class="eixos-row">
                            <div class="eixo">
                                <div class="eixo-label">${label}</div>
                                <div class="eixo-pneus">
                                    ${renderPneuSlot(veiculo, `traseiro-${i}-esquerdo-externo`, pneus[`traseiro-${i}-esquerdo-externo`])}
                                    ${renderPneuSlot(veiculo, `traseiro-${i}-esquerdo-interno`, pneus[`traseiro-${i}-esquerdo-interno`])}
                                    ${renderPneuSlot(veiculo, `traseiro-${i}-direito-interno`, pneus[`traseiro-${i}-direito-interno`])}
                                    ${renderPneuSlot(veiculo, `traseiro-${i}-direito-externo`, pneus[`traseiro-${i}-direito-externo`])}
                                </div>
                            </div>
                        </div>
                    `;
            }

            html += `
                    <div class="estepe-section">
                        <div class="eixos-row">
                            <div class="eixo">
                                <div class="eixo-label" style="color:#f57c00;">🟧 Estepes</div>
                                <div class="eixo-pneus">
                                    ${renderPneuSlot(veiculo, 'estepe-1', pneus['estepe-1'], true)}
                                    ${renderPneuSlot(veiculo, 'estepe-2', pneus['estepe-2'], true)}
                                    ${renderPneuSlot(veiculo, 'estepe-3', pneus['estepe-3'], true)}
                                    ${renderPneuSlot(veiculo, 'estepe-4', pneus['estepe-4'], true)}
                                </div>
                            </div>
                        </div>
                    </div>
                `;

            html += `</div>`;
            container.innerHTML = html;
        }

        function renderPneuSlot(veiculo, slotId, pneuId, isEstepe = false) {
            const pneus = getPneus();
            const pneu = pneuId ? pneus.find(p => p.id === pneuId) : null;

            const slotClass = isEstepe ? 'estepe' : '';
            const ocupadoClass = pneu ? 'ocupado' : '';

            if (pneu) {
                return `
                        <div class="pneu-slot ${ocupadoClass} ${slotClass}" 
                             draggable="true"
                             ondragstart="iniciarDrag(event, ${veiculo.id}, '${slotId}')"
                             ondragend="limparDrag(event)"
                             onclick="abrirMenuPneu(${veiculo.id}, '${slotId}')">
                            <div class="pneu-info">${pneu.nome}</div>
                            <div class="pneu-detalhes">${pneu.tamanho}</div>
                            <button class="remove-pneu" onclick="event.stopPropagation(); abrirModalRemocao(${veiculo.id}, '${slotId}')">✕</button>
                        </div>
                    `;
            } else {
                return `
                        <div class="pneu-slot ${slotClass}"
                             ondragover="permitirDrop(event)"
                             ondragleave="limparDrag(event)"
                             ondrop="finalizarDrop(event, ${veiculo.id}, '${slotId}')"
                             onclick="abrirModalSelecao(${veiculo.id}, '${slotId}')">
                            <span style="font-size:20px;">➕</span>
                            ${isEstepe ? '<div style="font-size:8px;color:#f57c00;">Estepe</div>' : ''}
                        </div>
                    `;
            }
        }

        // ============================================
        //  MENU DO PNEU
        // ============================================
        function abrirMenuPneu(veiculoId, slotId) {
            const veiculos = getVeiculos();
            const veiculo = veiculos.find(v => v.id === veiculoId);
            if (!veiculo || !veiculo.pneus) return;

            const pneuId = veiculo.pneus[slotId];
            if (!pneuId) return;

            const pneus = getPneus();
            const pneu = pneus.find(p => p.id === pneuId);
            if (!pneu) return;

            const opcoes = prompt(
                `Pneu: ${pneu.nome} ${pneu.tamanho}\nValor: R$ ${pneu.valor.toFixed(2)}\n\n` +
                `Selecione uma opção:\n` +
                `1. 🔧 Adicionar Serviço\n` +
                `2. 📦 Remover Pneu\n` +
                `3. ✏️ Editar Pneu\n\n` +
                `Digite o número da opção:`
            );
            
            if (opcoes === '1') {
                abrirModalServico(veiculoId, slotId);
            } else if (opcoes === '2') {
                abrirModalRemocao(veiculoId, slotId);
            } else if (opcoes === '3') {
                abrirModalEdicaoPneu(veiculoId, slotId);
            }
        }

        // ============================================
        //  MODAL DE SELEÇÃO (INSTALAÇÃO) - CORRIGIDO
        // ============================================
        function abrirModalSelecao(veiculoId, slotId) {
            const veiculos = getVeiculos();
            const veiculo = veiculos.find(v => v.id === veiculoId);
            if (!veiculo) return;

            // Salva o ID do veículo e o slot para uso posterior
            veiculoInstalacaoId = veiculoId;
            slotSelecionado = slotId;

            // Busca pneus disponíveis
            const pneus = getPneus();
            const pneusDisponiveis = pneus.filter(p => p.status === 'disponivel' || !p.status);

            if (pneusDisponiveis.length === 0) {
                alert('Não há pneus disponíveis no estoque para instalação.');
                return;
            }

            const modal = document.getElementById('modalSelecao');
            const lista = document.getElementById('listaPneusDisponiveis');
            const info = document.getElementById('infoPneuSelecao');

            const nomeSlot = slotId.replace(/-/g, ' ').replace(/estepe/g, 'Estepe');
            info.textContent = `Selecione um pneu para instalar em: ${nomeSlot}`;

            lista.innerHTML = pneusDisponiveis.map(p => `
                    <div class="item-pneu-disponivel" onclick="abrirModalInstalacao(${p.id})">
                        <div class="info">
                            <span class="nome">${p.nome}</span>
                            <span class="detalhes">${p.tamanho} • ${p.tipo} • ${p.situacao} • R$ ${p.valor.toFixed(2)}</span>
                        </div>
                        <span class="qtd">1</span>
                    </div>
                `).join('');

            modal.classList.add('show');
        }

        function fecharModalSelecao() {
            document.getElementById('modalSelecao').classList.remove('show');
        }

        // ============================================
        //  MODAL DE INSTALAÇÃO (KM) - CORRIGIDO
        // ============================================
        function abrirModalInstalacao(pneuId) {
            pneuSelecionadoId = pneuId;

            // Recupera o veículo usando o ID salvo
            const veiculos = getVeiculos();
            const veiculo = veiculos.find(v => v.id === veiculoInstalacaoId);
            if (!veiculo) {
                alert('Veículo não encontrado.');
                return;
            }
            veiculoAtual = veiculo;

            document.getElementById('infoInstalacao').textContent = 
                `Instalando pneu em: ${slotSelecionado.replace(/-/g, ' ')} - Veículo: ${veiculo.marca} ${veiculo.modelo}`;
            document.getElementById('kmInstalacao').value = veiculo.km;
            document.getElementById('kmInstalacao').min = veiculo.km;

            fecharModalSelecao();
            document.getElementById('modalInstalacao').classList.add('show');
        }

        function fecharModalInstalacao() {
            document.getElementById('modalInstalacao').classList.remove('show');
            pneuSelecionadoId = null;
        }

        function confirmarInstalacao() {
            // Verifica se temos todos os dados necessários
            if (!veiculoAtual || !slotSelecionado || !pneuSelecionadoId) {
                alert('Erro: Dados incompletos para instalação.');
                fecharModalInstalacao();
                return;
            }

            const km = parseInt(document.getElementById('kmInstalacao').value);
            if (!km || km < 0) {
                alert('Por favor, informe uma quilometragem válida.');
                return;
            }

            if (km < veiculoAtual.km) {
                alert('A quilometragem não pode ser menor que a atual do veículo.');
                return;
            }

            // Atualiza KM do veículo
            const veiculos = getVeiculos();
            const idx = veiculos.findIndex(v => v.id === veiculoAtual.id);
            if (idx !== -1) {
                veiculos[idx].km = km;
                veiculoAtual.km = km;
                setVeiculos(veiculos);
            }

            // Instala o pneu
            const pneus = getPneus();
            const pneu = pneus.find(p => p.id === pneuSelecionadoId);
            if (!pneu) {
                alert('Pneu não encontrado no estoque.');
                fecharModalInstalacao();
                return;
            }

            // Atualiza status do pneu
            pneu.status = 'instalado';
            pneu.veiculoInstalado = veiculoAtual.placa;

            // Adiciona ao veículo
            if (!veiculoAtual.pneus) veiculoAtual.pneus = {};
            veiculoAtual.pneus[slotSelecionado] = pneuSelecionadoId;

            // Registra histórico do pneu
            pneu.historico = pneu.historico || [];
            pneu.historico.push({
                data: new Date().toLocaleString('pt-BR'),
                acao: 'Instalação',
                detalhes: `Instalado no veículo ${veiculoAtual.placa} - ${veiculoAtual.marca} ${veiculoAtual.modelo} na posição ${slotSelecionado} com KM ${km}`
            });

            setPneus(pneus);

            // Atualiza veículo
            const idxVeiculo = veiculos.findIndex(v => v.id === veiculoAtual.id);
            if (idxVeiculo !== -1) {
                veiculos[idxVeiculo] = veiculoAtual;
                setVeiculos(veiculos);
            }

            // Limpa variáveis temporárias
            const slotTemp = slotSelecionado;
            const veiculoTemp = veiculoAtual;

            fecharModalInstalacao();
            
            // Recarrega a visualização
            renderCaminhao(veiculoTemp);
            renderVeiculos();
            renderEstoque();
            
            alert(`✅ Pneu ${pneu.nome} instalado com sucesso!`);
        }

        // ============================================
        //  MODAL DE REMOÇÃO
        // ============================================
        let slotRemocao = null;

        function abrirModalRemocao(veiculoId, slotId) {
            const veiculos = getVeiculos();
            const veiculo = veiculos.find(v => v.id === veiculoId);
            if (!veiculo || !veiculo.pneus) return;

            const pneuId = veiculo.pneus[slotId];
            if (!pneuId) return;

            const pneus = getPneus();
            const pneu = pneus.find(p => p.id === pneuId);
            if (!pneu) return;

            slotRemocao = slotId;
            veiculoAtual = veiculo;

            const infoBox = document.getElementById('pneuRemocaoInfo');
            infoBox.innerHTML = `
                    <div class="info-row"><span class="label">Pneu:</span> <span>${pneu.nome}</span></div>
                    <div class="info-row"><span class="label">Tamanho:</span> <span>${pneu.tamanho}</span></div>
                    <div class="info-row"><span class="label">Situação:</span> <span>${pneu.situacao}</span></div>
                    <div class="info-row"><span class="label">Valor Total:</span> <span>R$ ${pneu.valor.toFixed(2)}</span></div>
                    <div class="info-row"><span class="label">Posição:</span> <span>${slotId.replace(/-/g, ' ')}</span></div>
                `;

            document.getElementById('kmRemocao').value = veiculo.km;
            document.getElementById('kmRemocao').min = veiculo.km;
            document.getElementById('destinoPneu').value = '';

            document.getElementById('modalRemocao').classList.add('show');
        }

        function fecharModalRemocao() {
            document.getElementById('modalRemocao').classList.remove('show');
            slotRemocao = null;
        }

        function confirmarRemocao() {
            const km = parseInt(document.getElementById('kmRemocao').value);
            const destino = document.getElementById('destinoPneu').value;

            if (!km || km < 0) {
                alert('Por favor, informe uma quilometragem válida.');
                return;
            }

            if (km < veiculoAtual.km) {
                alert('A quilometragem não pode ser menor que a atual do veículo.');
                return;
            }

            if (!destino) {
                alert('Por favor, selecione o destino do pneu.');
                return;
            }

            // Atualiza KM do veículo
            const veiculos = getVeiculos();
            const idx = veiculos.findIndex(v => v.id === veiculoAtual.id);
            if (idx !== -1) {
                veiculos[idx].km = km;
                veiculoAtual.km = km;
                setVeiculos(veiculos);
            }

            // Remove o pneu do veículo
            const pneuId = veiculoAtual.pneus[slotRemocao];
            if (!pneuId) {
                alert('Erro: Pneu não encontrado.');
                fecharModalRemocao();
                return;
            }

            delete veiculoAtual.pneus[slotRemocao];

            // Atualiza o veículo
            const idxVeiculo = veiculos.findIndex(v => v.id === veiculoAtual.id);
            if (idxVeiculo !== -1) {
                veiculos[idxVeiculo] = veiculoAtual;
                setVeiculos(veiculos);
            }

            // Processa o pneu conforme destino
            const pneus = getPneus();
            const pneu = pneus.find(p => p.id === pneuId);
            if (!pneu) {
                alert('Erro: Pneu não encontrado no estoque.');
                fecharModalRemocao();
                return;
            }

            const destinoLabels = {
                'estoque_meia_vida': 'Voltou ao estoque como Meia Vida',
                'recapagem': 'Enviado para Recapagem',
                'vulcanizacao': 'Enviado para Vulcanização',
                'descarte': 'Descartado'
            };

            pneu.historico = pneu.historico || [];
            pneu.historico.push({
                data: new Date().toLocaleString('pt-BR'),
                acao: 'Remoção',
                detalhes: `Removido do veículo ${veiculoAtual.placa} - ${veiculoAtual.marca} ${veiculoAtual.modelo} na posição ${slotRemocao} com KM ${km}. Destino: ${destinoLabels[destino] || destino}`
            });

            // Ações conforme destino
            if (destino === 'estoque_meia_vida') {
                pneu.situacao = 'meia vida';
                pneu.status = 'disponivel';
                pneu.veiculoInstalado = null;
            } else if (destino === 'recapagem') {
                pneu.status = 'recapagem';
                pneu.situacao = 'recapado';
                pneu.veiculoInstalado = null;
            } else if (destino === 'vulcanizacao') {
                pneu.status = 'vulcanizacao';
                pneu.situacao = 'vulcanizado';
                pneu.veiculoInstalado = null;
            } else if (destino === 'descarte') {
                const descartados = getDescartados();
                pneu.motivoDescarte = 'Removido do veículo';
                pneu.dataDescarte = new Date().toLocaleDateString('pt-BR');
                descartados.push({...pneu});
                setDescartados(descartados);
                
                const idxPneu = pneus.findIndex(p => p.id === pneuId);
                if (idxPneu !== -1) {
                    pneus.splice(idxPneu, 1);
                }
                setPneus(pneus);
                renderDescartados();
                fecharModalRemocao();
                renderCaminhao(veiculoAtual);
                renderVeiculos();
                renderEstoque();
                alert(`✅ Pneu descartado com sucesso!`);
                return;
            }

            setPneus(pneus);

            fecharModalRemocao();
            renderCaminhao(veiculoAtual);
            renderVeiculos();
            renderEstoque();
            alert(`✅ Pneu removido com sucesso! Destino: ${destinoLabels[destino]}`);
        }


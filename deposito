        // ============================================
        //  MODAL DE EDIÇÃO (ESTOQUE)
        // ============================================
        let idsEdicao = [];

        function abrirModalEdicao(idsString) {
            idsEdicao = idsString.split(',').map(Number);
            const pneus = getPneus();
            const primeiroPneu = pneus.find(p => p.id === idsEdicao[0]);
            
            if (!primeiroPneu) {
                alert('Pneu não encontrado.');
                return;
            }

            const infoBox = document.getElementById('pneuEdicaoInfo');
            infoBox.innerHTML = `
                    <div class="info-row"><span class="label">Pneu:</span> <span>${primeiroPneu.nome}</span></div>
                    <div class="info-row"><span class="label">Tamanho:</span> <span>${primeiroPneu.tamanho}</span></div>
                    <div class="info-row"><span class="label">Situação:</span> <span>${primeiroPneu.situacao}</span></div>
                    <div class="info-row"><span class="label">Status:</span> <span>${primeiroPneu.status || 'Disponível'}</span></div>
                    <div class="info-row"><span class="label">Valor:</span> <span>R$ ${primeiroPneu.valor.toFixed(2)}</span></div>
                    <div class="info-row"><span class="label">Quantidade:</span> <span>${idsEdicao.length}</span></div>
                `;

            document.getElementById('valorRecapagem').value = primeiroPneu.valorRecapagem || '';
            document.getElementById('valorVulcanizacao').value = primeiroPneu.valorVulcanizacao || '';
            document.getElementById('acaoEdicao').value = '';

            document.getElementById('modalEdicao').classList.add('show');
        }

        function fecharModalEdicao() {
            document.getElementById('modalEdicao').classList.remove('show');
            idsEdicao = [];
        }

        function confirmarEdicao() {
            const valorRecapagem = parseFloat(document.getElementById('valorRecapagem').value) || 0;
            const valorVulcanizacao = parseFloat(document.getElementById('valorVulcanizacao').value) || 0;
            const acao = document.getElementById('acaoEdicao').value;

            if (!acao && valorRecapagem === 0 && valorVulcanizacao === 0) {
                alert('Selecione uma ação ou adicione um valor.');
                return;
            }

            const pneus = getPneus();
            let pneusAtualizados = 0;

            idsEdicao.forEach(id => {
                const pneu = pneus.find(p => p.id === id);
                if (!pneu) return;

                // Atualiza valores
                if (valorRecapagem > 0) {
                    pneu.valorRecapagem = valorRecapagem;
                    pneu.valor += valorRecapagem;
                }
                if (valorVulcanizacao > 0) {
                    pneu.valorVulcanizacao = valorVulcanizacao;
                    pneu.valor += valorVulcanizacao;
                }

                // Executa ação
                if (acao === 'recapagem') {
                    pneu.situacao = 'recapado';
                    pneu.status = 'disponivel';
                    pneu.veiculoInstalado = null;
                    pneu.historico = pneu.historico || [];
                    pneu.historico.push({
                        data: new Date().toLocaleString('pt-BR'),
                        acao: 'Recapagem',
                        detalhes: `Pneu recapado com valor de R$ ${valorRecapagem.toFixed(2)}`
                    });
                    pneusAtualizados++;
                } else if (acao === 'vulcanizacao') {
                    pneu.situacao = 'vulcanizado';
                    pneu.status = 'disponivel';
                    pneu.veiculoInstalado = null;
                    pneu.historico = pneu.historico || [];
                    pneu.historico.push({
                        data: new Date().toLocaleString('pt-BR'),
                        acao: 'Vulcanização',
                        detalhes: `Pneu vulcanizado com valor de R$ ${valorVulcanizacao.toFixed(2)}`
                    });
                    pneusAtualizados++;
                } else if (acao === 'descarte') {
                    const descartados = getDescartados();
                    pneu.motivoDescarte = 'Descartado via edição';
                    pneu.dataDescarte = new Date().toLocaleDateString('pt-BR');
                    descartados.push({...pneu});
                    setDescartados(descartados);
                    
                    const idxPneu = pneus.findIndex(p => p.id === id);
                    if (idxPneu !== -1) {
                        pneus.splice(idxPneu, 1);
                    }
                    pneusAtualizados++;
                }
            });

            setPneus(pneus);
            fecharModalEdicao();
            renderEstoque();
            renderDescartados();
            
            if (acao === 'descarte') {
                alert(`✅ ${pneusAtualizados} pneu(s) descartado(s) com sucesso!`);
            } else if (acao) {
                alert(`✅ ${pneusAtualizados} pneu(s) atualizado(s) com sucesso!`);
            } else {
                alert('✅ Valores atualizados com sucesso!');
            }
        }

        // ============================================
        //  INICIALIZAÇÃO
        // ============================================
        (function init() {
            const user = getCurrentUser();
            if (user) {
                const users = getUsers();
                const exists = users.find(u => u.id === user.id);
                if (exists) {
                    enterApp();
                    return;
                } else {
                    clearCurrentUser();
                }
            }
            document.getElementById('authContainer').style.display = 'block';
            document.getElementById('mainHeader').style.display = 'none';
            document.getElementById('appContainer').classList.remove('show');
            switchAuthTab('login');
        })();

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && (e.target.id === 'pneuNomeOutros' || e.target.id === 'pneuTamanhoOutros')) {
                e.preventDefault();
                document.getElementById('pneuForm').dispatchEvent(new Event('submit'));
            }
            if (e.key === 'Escape') {
                fecharModalCaminhao();
                fecharModalSelecao();
                fecharModalInstalacao();
                fecharModalRemocao();
                fecharModalEdicao();
                fecharModalServico();
            }
        });

        document.getElementById('modalCaminhao').addEventListener('click', function(e) {
            if (e.target === this) fecharModalCaminhao();
        });
        document.getElementById('modalSelecao').addEventListener('click', function(e) {
            if (e.target === this) fecharModalSelecao();
        });
        document.getElementById('modalInstalacao').addEventListener('click', function(e) {
            if (e.target === this) fecharModalInstalacao();
        });
        document.getElementById('modalRemocao').addEventListener('click', function(e) {
            if (e.target === this) fecharModalRemocao();
        });
        document.getElementById('modalEdicao').addEventListener('click', function(e) {
            if (e.target === this) fecharModalEdicao();
        });
        document.getElementById('modalServico').addEventListener('click', function(e) {
            if (e.target === this) fecharModalServico();
        });
    </script>
</body>
</html>


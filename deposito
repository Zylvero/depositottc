        // ============================================
        //  VEÍCULOS
        // ============================================
        function cadastrarVeiculo(e) {
            e.preventDefault();

            const marca = document.getElementById('veiculoMarca').value.trim();
            const modelo = document.getElementById('veiculoModelo').value.trim();
            const placa = document.getElementById('veiculoPlaca').value.trim().toUpperCase();
            const motorista = document.getElementById('veiculoMotorista').value.trim();
            const km = parseInt(document.getElementById('veiculoKm').value) || 0;
            const eixos = parseInt(document.getElementById('veiculoEixos').value);
            const status = document.getElementById('veiculoStatus').value;

            if (!marca || !modelo || !placa || !motorista) {
                alert('Por favor, preencha todos os campos obrigatórios.');
                return;
            }

            const veiculos = getVeiculos();
            if (veiculos.find(v => v.placa === placa)) {
                alert('Esta placa já está cadastrada.');
                return;
            }

            const veiculo = {
                id: Date.now(),
                marca,
                modelo,
                placa,
                motorista,
                km,
                eixos,
                status,
                pneus: {},
                dataCadastro: new Date().toLocaleDateString('pt-BR')
            };

            veiculos.push(veiculo);
            setVeiculos(veiculos);

            document.getElementById('veiculoForm').reset();
            document.getElementById('veiculoKm').value = '0';

            renderVeiculos();
            alert('✅ Veículo cadastrado com sucesso!');

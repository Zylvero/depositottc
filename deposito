        function renderVeiculos() {
            const veiculos = getVeiculos();
            const grid = document.getElementById('veiculosGrid');

            if (veiculos.length === 0) {
                grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1;"><p>Nenhum veículo cadastrado ainda.</p></div>`;
                document.getElementById('totalVeiculos').textContent = 'Total: 0';
                document.getElementById('veiculosAtivos').textContent = 'Ativos: 0';
                return;
            }

            let ativos = 0;
            let html = '';
            veiculos.forEach((v) => {
                if (v.status === 'ativo') ativos++;
                const statusBadge = v.status === 'ativo' ? 'badge-ativo' : 'badge-inativo';
                const totalPneus = (v.eixos - 1) * 4 + 2 + 4;
                const pneusInstalados = v.pneus ? Object.keys(v.pneus).length : 0;

                html += `
                        <div class="veiculo-card" onclick="abrirModalCaminhao(${v.id})">
                            <div class="veiculo-card-header">
